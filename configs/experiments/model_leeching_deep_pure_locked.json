{
  "dataset": "model_leeching",
  "embedding_model": "artifacts/models/bge-small-en-v1.5",
  "device": "cuda",
  "dtype": "float64",
  "output": "artifacts/model_leeching_deep_pure_v1",
  "protocol_lock": "artifacts/model_leeching_protocol_v1",
  "methods": [
    "deep_kernel"
  ],
  "seeds": [
    1,
    20,
    42
  ],
  "window_sizes": [
    100,
    250
  ],
  "attacker_ratios": [
    0.01,
    0.05,
    0.1,
    0.25,
    1.0
  ],
  "reference_repeats": 20,
  "calibration_windows": 500,
  "test_windows": 200,
  "target_fpr": 0.05,
  "training": {
    "mode": "pure",
    "window_size": 100,
    "epochs": 30,
    "steps_per_epoch": 16,
    "validation_pairs": 32,
    "hidden_dim": 128,
    "feature_dim": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "variance_regularizer": 1e-08,
    "gradient_clip": 10.0
  }
}
