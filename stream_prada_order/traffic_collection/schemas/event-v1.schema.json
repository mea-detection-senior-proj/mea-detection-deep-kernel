{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stream-prada:traffic:event-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "traffic-event-v1"
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "run_opened",
        "session_opened",
        "request_started",
        "attempt_started",
        "attempt_succeeded",
        "attempt_failed",
        "attempt_unknown",
        "request_finished",
        "session_closed",
        "run_closed"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "clock_epoch": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "utc_regressed": {
      "type": "boolean"
    },
    "data": {}
  },
  "required": [
    "schema_version",
    "event_sequence",
    "kind",
    "run_id",
    "session_id",
    "request_id",
    "utc",
    "monotonic_ns",
    "clock_epoch",
    "utc_regressed",
    "data"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "run_opened"
        },
        "data": {
          "type": "object",
          "properties": {
            "manifest": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "const": "traffic-manifest-v1"
                },
                "run_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                },
                "traffic_kind": {
                  "enum": [
                    "mock",
                    "real"
                  ]
                },
                "label": {
                  "enum": [
                    "benign",
                    "attack"
                  ]
                },
                "collector_revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "protocol_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "actor_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_group_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "victim": {
                  "type": "object",
                  "properties": {
                    "model_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_./-]{1,160}$"
                    },
                    "model_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "tokenizer_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_./-]{1,160}$"
                    },
                    "tokenizer_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "model_id",
                    "model_revision",
                    "tokenizer_id",
                    "tokenizer_revision"
                  ],
                  "additionalProperties": false
                },
                "authorization": {
                  "type": "object",
                  "properties": {
                    "record_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                    },
                    "evidence_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "record_id",
                    "evidence_sha256"
                  ],
                  "additionalProperties": false
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "document_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                      },
                      "content_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "license_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                      },
                      "provenance_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "document_id",
                      "content_sha256",
                      "license_id",
                      "provenance_sha256"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "task_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "split": {
                  "enum": [
                    "fit",
                    "calibration",
                    "validation",
                    "final_test",
                    "development"
                  ]
                },
                "acquisition": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "method_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                        },
                        "code_revision": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        },
                        "configuration_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "lineage_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "query_pool_sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "response_dependent": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "method_id",
                        "code_revision",
                        "configuration_sha256",
                        "lineage_sha256",
                        "query_pool_sha256",
                        "response_dependent"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "budget": {
                  "type": "object",
                  "properties": {
                    "max_requests": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_attempts": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_attempts_per_request": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "max_session_attempts": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_query_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1048576
                    },
                    "max_response_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1048576
                    },
                    "max_logical_storage_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "max_requests",
                    "max_attempts",
                    "max_attempts_per_request",
                    "max_session_attempts",
                    "max_query_bytes",
                    "max_response_bytes",
                    "max_logical_storage_bytes"
                  ],
                  "additionalProperties": false
                },
                "retry_policy": {
                  "const": "not_sent_only"
                }
              },
              "required": [
                "schema_version",
                "run_id",
                "traffic_kind",
                "label",
                "collector_revision",
                "protocol_sha256",
                "actor_sha256",
                "source_group_sha256",
                "victim",
                "authorization",
                "sources",
                "task_ids",
                "split",
                "acquisition",
                "budget",
                "retry_policy"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "manifest"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "session_opened"
        },
        "data": {
          "type": "object",
          "properties": {
            "native_session_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "native_session_sha256"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "request_started"
        },
        "data": {
          "type": "object",
          "properties": {
            "request_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "session_request_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "query_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "normalized_query_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "query_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "words": {
              "type": "integer",
              "minimum": 1
            },
            "characters": {
              "type": "integer",
              "minimum": 1
            },
            "document_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "task_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "format_class": {
              "enum": [
                "question_only",
                "context_request",
                "code",
                "mixed",
                "other"
              ]
            },
            "decision": {
              "type": "object",
              "properties": {
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "based_on_attempt_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": [
                "sha256",
                "based_on_attempt_ids"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "request_sequence",
            "session_request_sequence",
            "query_sha256",
            "normalized_query_sha256",
            "query_bytes",
            "words",
            "characters",
            "document_ids",
            "task_id",
            "format_class",
            "decision"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "attempt_started"
        },
        "data": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "attempt_number": {
              "type": "integer",
              "minimum": 1
            },
            "dispatch_sequence": {
              "type": "integer",
              "minimum": 1
            },
            "retry_of": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "attempt_id",
            "attempt_number",
            "dispatch_sequence",
            "retry_of"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "attempt_succeeded"
        },
        "data": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "response_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "response_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "token_origin": {
              "enum": [
                "mock_reported",
                "adapter_reported",
                "unavailable"
              ]
            },
            "delivery": {
              "const": "accepted"
            }
          },
          "required": [
            "attempt_id",
            "response_sha256",
            "response_bytes",
            "input_tokens",
            "output_tokens",
            "token_origin",
            "delivery"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "attempt_failed"
        },
        "data": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "code": {
              "enum": [
                "timeout",
                "adapter_failure",
                "execution_disabled",
                "invalid_response",
                "rate_limit",
                "budget_exhausted"
              ]
            },
            "delivery": {
              "enum": [
                "not_sent",
                "accepted",
                "unknown"
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "attempt_id",
            "code",
            "delivery",
            "retryable"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "attempt_unknown"
        },
        "data": {
          "type": "object",
          "properties": {
            "attempt_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            "code": {
              "const": "process_interrupted"
            },
            "delivery": {
              "const": "unknown"
            },
            "retryable": {
              "const": false
            }
          },
          "required": [
            "attempt_id",
            "code",
            "delivery",
            "retryable"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "request_finished"
        },
        "data": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "succeeded",
                "failed",
                "unknown"
              ]
            },
            "recovered": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                "completed",
                "adapter_failure",
                "process_interrupted",
                "invalid_response",
                "budget_exhausted"
              ]
            }
          },
          "required": [
            "status",
            "recovered",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "session_closed"
        },
        "data": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "normal",
                "process_interrupted"
              ]
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "kind": {
          "const": "run_closed"
        },
        "data": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "normal",
                "process_interrupted"
              ]
            }
          },
          "required": [
            "reason"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
